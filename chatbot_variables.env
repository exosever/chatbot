# Environment variables for the Twitch Chatbot

# Twitch Configuration
TWITCH_TOKEN="YOUR_TWITCH_TOKEN_HERE"  # Twitch OAuth token (e.g., from https://twitchapps.com/tmi/)
TWITCH_NICKNAME="YOUR_BOT_NICKNAME_HERE"  # Bot's Twitch username
TWITCH_CHANNEL="YOUR_TWITCH_CHANNEL_HERE"  # Channel to connect to (e.g., #yourusername)
TWITCH_PREFIX="!"  # Command prefix for the bot

# Logging Configuration
LOGGING_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
VERBOSE_LOGGING="False" # True or False - Enables more detailed logging for debugging

# AI Configuration (Google Gemini) - DEPRECATE_GEMINI_IN_FAVOR_OF_OPENAI
GOOGLE_GEMINI_API_KEY="YOUR_GOOGLE_GEMINI_API_KEY_HERE" 
GOOGLE_GEMINI_MAX_TOKENS=1000 # Maximum number of tokens for Gemini responses
GOOGLE_GEMINI_TEMPERATURE=0.7 # Creativity of Gemini responses (0.0 - 1.0)

# OpenAI Configuration
OPENAI_API_KEY="YOUR_OPENAI_API_KEY_HERE"
OPENAI_ASSISTANT_ID="YOUR_OPENAI_ASSISTANT_ID_HERE"
OPENAI_VECTOR_STORE_ID="YOUR_OPENAI_VECTOR_STORE_ID_HERE" # Added for long-term memory uploads
LONG_TERM_MEMORY_UPLOAD_INTERVAL_SECONDS=3600 # 1 hour

# Text-to-Speech (TTS) Configuration
TTS_ENABLED="False"  # True or False - Enable or disable TTS
TTS_ENGINE="google"  # 'google' or 'elevenlabs'
TTS_VOICE_NAME_GOOGLE="en-US-Wavenet-D" # Example Google Voice name
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY_HERE"
ELEVENLABS_VOICE_ID="YOUR_ELEVENLABS_VOICE_ID_HERE"
MAX_TTS_CHARACTERS=300 # Maximum characters for a TTS message to prevent abuse
TTS_COOLDOWN_SECONDS=10 # Cooldown between TTS messages per user

# Speech-to-Text (STT) Configuration
STT_ENABLED="False" # True or False - Enable or disable STT (Requires a microphone input)
STT_LANGUAGE="en-US" # Language for STT
STT_PHRASE_TIME_LIMIT=10 # Maximum seconds for a voice command

# Optional Features
COMMAND_COOLDOWN_SECONDS=5 # Cooldown for general commands per user
MODERATOR_USERS="your_username,another_moderator" # Comma-separated list of users with moderator privileges for the bot
LAST_FM_API_KEY="YOUR_LAST_FM_API_KEY_HERE" # For !song command
SPOTIFY_CLIENT_ID="YOUR_SPOTIFY_CLIENT_ID_HERE" # For Spotify integration (future)
SPOTIFY_CLIENT_SECRET="YOUR_SPOTIFY_CLIENT_SECRET_HERE" # For Spotify integration (future)
OPENWEATHERMAP_API_KEY="YOUR_OPENWEATHERMAP_API_KEY_HERE" # For !weather command

# Conversation Memory
CONVERSATION_MEMORY_MAX_TOKENS=8000 # Maximum tokens to retain in short-term conversation history (approx. 2000-3000 words)
CONVERSATION_MEMORY_TRIM_PERCENTAGE=0.2 # Percentage of oldest messages to trim when memory limit is reached
MEMORY_FILE_PATH="conversation_memory.json" # File to save and load conversation history

# Vision / Image Processing (Optional)
VISION_ENABLED="False" # Enable to allow the bot to process images (e.g., from URLs)
IMAGE_DOWNLOAD_PATH="downloaded_images" # Folder to store downloaded images temporarily

# Custom Prompts - You can override the default system prompts here
SYSTEM_PROMPT_GENERAL="You are a helpful and entertaining Twitch chatbot. Your name is {bot_name}."
SYSTEM_PROMPT_SUMMARIZE_MEMORY="Summarize the following conversation concisely, highlighting key topics and user sentiments. This summary will be used to provide context for future interactions."

# Dynamic Commands (Optional)
DYNAMIC_COMMANDS_FILE="dynamic_commands.json" # File to store user-created commands

# Bot Personality & Behavior
BOT_RESPONSE_STYLE="informative" # "informative", "humorous", "sarcastic", "helpful"
REPLY_TO_MENTIONS_CHANCE=0.8 # (0.0 to 1.0) Likelihood of replying when @mentioned without a command
RANDOM_CHAT_ENABLED="False" # Allow the bot to occasionally send messages without being prompted
RANDOM_CHAT_INTERVAL_MINUTES=30 # Minimum interval for random chat messages
RANDOM_CHAT_MESSAGES_FILE="random_chat_messages.txt" # File with messages for random chat (one per line)

# External API URLs (Modify if using self-hosted or different endpoints)
# Example: GEMINI_API_ENDPOINT="YOUR_CUSTOM_GEMINI_ENDPOINT_HERE"

# --- ADVANCED CONFIGURATION ---
# These settings are for advanced users and generally don't need to be changed.
TWITCH_RATE_LIMIT_PER_30_SECONDS=100 # Max messages bot can send in 30s (Twitch limit)
TWITCH_MODERATOR_RATE_LIMIT_PER_30_SECONDS=7500 # Max messages for moderator status
HEARTBEAT_INTERVAL_SECONDS=300 # How often to send PING to Twitch to keep connection alive
MAX_RETRIES_ON_ERROR=3 # Number of times to retry an operation (e.g., API call) on failure
RETRY_DELAY_SECONDS=5 # Seconds to wait before retrying a failed operation
WEBSOCKET_TIMEOUT_SECONDS=10 # Timeout for websocket connections
REQUESTS_TIMEOUT_SECONDS=15 # Timeout for HTTP requests to external APIs
MEMORY_SAVE_INTERVAL_SECONDS=300 # How often to save conversation memory to disk
DEBUG_MODE="False" # Enables extra verbose logging and potentially unsafe operations. DO NOT USE IN PRODUCTION.
